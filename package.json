{
  "name": "cutroom",
  "version": "0.1.0",
  "description": "A small video editor that does five things well and nothing else.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "test": "node --test test/*.test.js",
    "test:electron": "node --test test/electron/*.test.js",
    "lint": "eslint ."
  },
  "author": "Holiday Malepe",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "eslint": "^9.39.5",
    "jsdom": "^26.1.0",
    "playwright": "^1.62.1"
  },
  "build": {
    "appId": "com.holiday.cutroom",
    "files": [
      "main.js",
      "preload.js",
      "shared/**",
      "src/**",
      "package.json"
    ]
  }
}
